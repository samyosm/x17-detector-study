# Target in the barrel context; transparent bars and walls retain the scale.
/control/execute macros/figures/style.mac
/vis/geometry/set/colour Scintillator 0 0 1 1 0.18
/vis/geometry/set/colour MWPCInnerWall 0 0.5 0.5 0.5 0.18
/vis/geometry/set/colour BeamlineWall 0 0 1 0 0.20
/vis/geometry/set/visibility ScintillatorWrap 0 false
/vis/geometry/set/visibility MWPCOuterWall 0 false
/vis/geometry/set/visibility MWPCGas 0 false
/vis/drawVolume
/vis/viewer/set/targetPoint 0 0 0 cm
/vis/viewer/set/viewpointVector 1 0.8 0.6
/vis/viewer/set/upVector 0 0 1
/vis/viewer/zoomTo 3.4
/vis/viewer/flush
