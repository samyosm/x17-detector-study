# Draw only the chamber, beamline, and target volumes to avoid loading all bars.
/control/execute macros/figures/style.mac
/vis/drawVolume MWPCWall
/vis/scene/add/volume BeamlineWall
/vis/scene/add/volume BeamlineVacuum
/vis/viewer/set/targetPoint 0 0 0 cm
/vis/viewer/set/viewpointVector 1 1 0.6
/vis/viewer/set/upVector 0 0 1
/vis/viewer/zoomTo 1
/vis/viewer/flush
