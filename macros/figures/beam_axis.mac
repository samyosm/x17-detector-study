# Looking along +z from the U end, toward the target and D end.
/control/execute macros/figures/style.mac
/vis/drawVolume
# A small tilt reveals the depth of the ring while retaining the beam-axis view.
/vis/viewer/set/viewpointVector 0.12 0.08 1
/vis/viewer/set/upVector 0 1 0
# The barrel's 160 cm axial extent sets the scene scale; larger zoom crops its ring.
/vis/viewer/zoomTo 1.2
/vis/viewer/flush
